#-- Ionization Detail scorer
s:Sc/Patient/Tally_ionizationDetail/Quantity 			        = "IDetail"
s:Sc/Patient/Tally_ionizationDetail/OutputFile 			        = Sim/ScoreLabel + "_ionizationDetail"
s:Sc/Patient/Tally_ionizationDetail/AveragingMethod 		    = Sim/AverageMethod                 # default is "track"
b:Sc/Patient/Tally_ionizationDetail/InterpolateFrequencies 	    = Sim/interpBool                    # default is "True"
s:Sc/Patient/Tally_ionizationDetail/Component 			        = "Patient"
d:Sc/Patient/Tally_ionizationDetail/IonMinKineticEnergy		    = Sim/ionMinKineticEnergy MeV       # default is 0.0 MeV
d:Sc/Patient/Tally_ionizationDetail/ElectronMinKineticEnergy	= Sim/electronMinKineticEnergy eV   # default is 0.0 eV
d:Sc/Patient/Tally_ionizationDetail/ProtonMinKineticEnergy	    = Sim/protonMinKineticEnergy eV     # default is 0.0 eV
s:Sc/Patient/Tally_ionizationDetail/DataBaseLocation		    = Sim/MCTSvFolder                   #"/home/s742o/TOPASplans/MCTS-DataBase"
s:Sc/Patient/Tally_ionizationDetail/IfOutputFileAlreadyExists 	= "Overwrite" 	                    #"Exit","Overwrite" or "Increment"

b:Sc/Patient/Tally_ionizationDetail/IncludeElectrons		    = Sim/ElectronsBool # default is "False"
b:Sc/Patient/Tally_ionizationDetail/IncludeNeutrons		        = Sim/NeutronBool # default is "False"
b:Sc/Patient/Tally_ionizationDetail/EnergyStepFromTrack		    = Sim/energyStepBool # default is "False"
#d:Sc/Patient/Tally_ionizationDetail/IonMaxKineticEnergy	    = 112.5 MeV

# Other parameters
s:Sc/Patient/Tally_ionizationDetail/OutputFileType 		        = "csv" # "csv" "binary" "Root" "Xml" or "DICOM"
b:Sc/Patient/Tally_ionizationDetail/OutputToConsole 	        = "False"
b:Sc/Patient/Tally_ionizationDetail/OutputAfterRun 		        = "False" 
b:Sc/Patient/Tally_ionizationDetail/Verbose 			        = "False"

############################# IDetail scorer ##########################################################################
b:Sc/Patient/Tally_ionizationDetail/IncludeExcitations			    = Sim/excitationBool # default is "False"
b:Sc/Patient/Tally_ionizationDetail/FilterByPrimariesSecondaries 	= Sim/filterPrimSecBool # default is "False"
b:Sc/Patient/Tally_ionizationDetail/IncludeIp				        = "True"

#######################################################################################################################